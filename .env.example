# Copy to .env.local (or run `npm run setup:env`, which fills these from `supabase status`).
# Only VITE_* variables are bundled into the browser. Never prefix secrets with VITE_.

# Public Supabase API URL and anon (publishable) key
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the web app (used in invitation and password-reset emails)
VITE_APP_URL=http://localhost:5180

# --- Server-side only (scripts and tests). NEVER expose to the frontend. ---
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password used for the development demo accounts created by `npm run setup:demo`.
# Leave blank to generate a random one (it is written back to .env.local).
DEMO_USER_PASSWORD=
