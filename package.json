{
  "name": "deviceflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DeviceFlow - device lifecycle, work order, warehouse, invoicing and dispatch management",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "setup:env": "node scripts/write-env.mjs",
    "setup:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "create-admin": "node --env-file=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-tabs": "1.1.1",
    "@supabase/supabase-js": "2.46.1",
    "@tanstack/react-query": "5.59.20",
    "@tanstack/react-table": "8.20.5",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "jsbarcode": "3.11.6",
    "lucide-react": "0.454.0",
    "papaparse": "5.4.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "react-router-dom": "6.28.0",
    "recharts": "2.13.3",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.9.0",
    "@types/papaparse": "5.3.15",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "supabase": "2.122.0",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
